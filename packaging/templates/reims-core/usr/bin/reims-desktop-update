#!/usr/bin/env python3
"""Command-line utility for Reims Desktop system updates via GitHub Releases and Git.

Usage:
  reims-desktop-update             Check and install available updates
  reims-desktop-update --check     Only check if new versions are available
  reims-desktop-update --git       Update directly from Git repository
  reims-desktop-update --branch <b Update from a specific Git branch (e.g. development)
  reims-desktop-update --commit <c Update to a specific Git commit hash
  reims-desktop-update --yes       Apply updates without interactive confirmation
  reims-desktop-update --dry-run   Simulate update without modifying the system
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# Add standard search paths for reims_gui or reims_core modules
for p in [
    "/usr/lib/reims-gui",
    "/usr/share/reims-gui",
    str(Path(__file__).resolve().parent.parent.parent.parent / "reims-gui" / "src"),
]:
    if p not in sys.path and os.path.exists(p):
        sys.path.insert(0, p)

try:
    from reims_gui.core.updater import SystemUpdater, ReleaseInfo
except ImportError:
    print("Warning: Module reims_gui.core.updater not found.", file=sys.stderr)
    raise


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Reims Desktop System Updater (GitHub Releases & Git)"
    )
    parser.add_argument(
        "-c", "--check",
        action="store_true",
        help="Check for updates and exit with status 0 (update available) or 1 (up to date)",
    )
    parser.add_argument(
        "-y", "--yes",
        action="store_true",
        help="Apply update automatically without asking for confirmation",
    )
    parser.add_argument(
        "--git",
        action="store_true",
        help="Update directly from public Git repository",
    )
    parser.add_argument(
        "-s", "--system",
        action="store_true",
        help="Update Ubuntu distribution packages and kernel/drivers (apt dist-upgrade)",
    )
    parser.add_argument(
        "--full",
        action="store_true",
        help="Update both Reims Desktop components and Ubuntu OS base packages",
    )
    parser.add_argument(
        "-b", "--branch",
        type=str,
        default=None,
        help="Git branch to pull from when using git mode (default: main)",
    )
    parser.add_argument(
        "--commit",
        type=str,
        default=None,
        help="Specific Git commit hash or reference to checkout when using git mode",
    )
    parser.add_argument(
        "--repo",
        type=str,
        default=None,
        help="Override GitHub repository (default: joaosantiag0/reims-desktop or $REIMS_GITHUB_REPO)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simulate download and installation without modifying the system",
    )
    parser.add_argument(
        "--mock",
        action="store_true",
        help="Mock/testing mode without network calls",
    )
    parser.add_argument(
        "-v", "--version",
        action="store_true",
        help="Display currently installed Reims Desktop version",
    )

    args = parser.parse_args()

    if args.mock:
        os.environ["REIMS_MOCK_UPDATER"] = "1"

    updater = SystemUpdater(repo=args.repo)

    if args.version:
        print(f"Reims Desktop installed version: {updater.current_version}")
        return 0

    print("==================================================")
    print("            Reims Desktop System Updater          ")
    print("==================================================")
    print(f"Current Version: {updater.current_version}")
    print(f"Repository:      https://github.com/{updater.repo}")
    print("--------------------------------------------------")

    # System-only update mode
    if args.system and not args.full and not args.git:
        print("==> Updating Ubuntu base distribution packages (APT)...")
        ok_sys, msg_sys = updater.update_system(dry_run=args.dry_run)
        if ok_sys:
            print(f"✓ {msg_sys}")
            return 0
        else:
            print(f"✗ Error updating system: {msg_sys}", file=sys.stderr)
            return 1

    # Auto-enable git mode if --branch or --commit is supplied
    if args.branch or args.commit:
        args.git = True

    # Git Update Mode
    if args.git:
        branch = args.branch or "main"
        target_info = f"commit {args.commit}" if args.commit else f"{branch} branch"
        print(f"==> Git mode enabled: Pulling from {target_info}...")
        ok, msg = updater.update_from_git(branch=branch, commit=args.commit, dry_run=args.dry_run)
        if ok:
            print(f"✓ {msg}")
            if args.full or args.system:
                print("==> Updating Ubuntu base distribution packages (APT)...")
                ok_sys, msg_sys = updater.update_system(dry_run=args.dry_run)
                if not ok_sys:
                    print(f"✗ Error updating system: {msg_sys}", file=sys.stderr)
                    return 1
                print(f"✓ {msg_sys}")
            return 0
        else:
            print(f"✗ Error: {msg}", file=sys.stderr)
            return 1

    # Release Check Mode
    print("==> Checking for updates on GitHub Releases...")
    release = updater.check_for_updates()

    if updater.last_check_error:
        print(f"✗ Failed to check for updates: {updater.last_check_error}", file=sys.stderr)
        print("  Tip: Verify internet/DNS connectivity or use 'reims-desktop-update --git' to pull from Git.")
        return 1

    if not release:
        print("✓ Your Reims Desktop is already on the latest version!")
        return 1 if args.check else 0

    print(f"\n🎉 New version found: {release.tag_name} (current: {updater.current_version})")
    print(f"Title: {release.name}")
    print(f"Date:  {release.published_at}")
    if release.body:
        print("\n--- Release Notes ---")
        print(release.body.strip())
        print("---------------------")

    deb_assets = release.deb_assets
    if not deb_assets:
        print("\nWarning: This release does not include .deb packages for automatic update.")
        print(f"More details at: {release.html_url}")
        return 0

    print(f"\nAvailable update packages ({len(deb_assets)}):")
    for a in deb_assets:
        size_kb = a.size / 1024 if a.size else 0
        print(f"  • {a.name} ({size_kb:.1f} KB)")

    if args.check:
        return 0

    if not args.yes:
        try:
            answer = input("\nDo you want to download and apply this update now? [Y/n]: ").strip().lower()
            if answer and answer not in ("y", "yes", "s", "sim"):
                print("Operation cancelled by user.")
                return 0
        except (KeyboardInterrupt, EOFError):
            print("\nOperation cancelled.")
            return 1

    download_dir = Path("/tmp/reims-update")
    print(f"\n==> Downloading packages to {download_dir}...")
    
    def on_progress(downloaded: int, total: int, filename: str):
        pct = (downloaded / total * 100) if total else 0
        sys.stdout.write(f"\r  [{pct:5.1f}%] {filename} ({downloaded}/{total} bytes)")
        sys.stdout.flush()

    try:
        debs = updater.download_assets(release, download_dir, progress_callback=on_progress)
        print("\n✓ Download completed successfully!")
    except Exception as e:
        print(f"\n✗ Error during download: {e}", file=sys.stderr)
        return 1

    print("\n==> Installing update on system...")
    ok, msg = updater.install_debs(debs, dry_run=args.dry_run)
    if ok:
        print(f"✓ {msg}")
        if args.full or args.system:
            print("\n==> Updating Ubuntu base distribution packages (APT)...")
            ok_sys, msg_sys = updater.update_system(dry_run=args.dry_run)
            if not ok_sys:
                print(f"✗ Error updating system: {msg_sys}", file=sys.stderr)
                return 1
            print(f"✓ {msg_sys}")
        print("\n🎉 Reims Desktop update completed successfully!")
        return 0
    else:
        print(f"✗ Error during installation: {msg}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
