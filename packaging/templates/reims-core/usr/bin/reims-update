#!/usr/bin/env bash
set -euo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${BIN_DIR}/reims-desktop-update" ]]; then
    exec "${BIN_DIR}/reims-desktop-update" "$@"
elif command -v reims-desktop-update &>/dev/null; then
    exec reims-desktop-update "$@"
else
    echo "ERRO: reims-desktop-update não encontrado!" >&2
    exit 1
fi
