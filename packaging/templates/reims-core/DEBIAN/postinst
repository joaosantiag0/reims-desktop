#!/usr/bin/env bash
set -euo pipefail

# Garante a existência do grupo kvm
if ! getent group kvm >/dev/null 2>&1; then
    groupadd -r kvm
fi

# Tenta recarregar regras udev se udevadm estiver presente
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger || true
fi

# Tenta carregar o módulo udmabuf imediatamente se estiver em host físico
if command -v modprobe >/dev/null 2>&1; then
    modprobe udmabuf || true
    modprobe kvm || true
fi

# Aplica tema do seletor de boot GRUB se a ferramenta estiver presente
if [ -x /usr/bin/reims-boot-theme-apply ]; then
    /usr/bin/reims-boot-theme-apply || true
fi

# Configura e ativa servidor OpenSSH para acesso LAN com senha e UFW liberado
if command -v ssh-keygen >/dev/null 2>&1; then
    ssh-keygen -A >/dev/null 2>&1 || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl enable ssh.socket >/dev/null 2>&1 || true
    systemctl enable ssh >/dev/null 2>&1 || true
    systemctl restart ssh.socket >/dev/null 2>&1 || true
    systemctl restart ssh >/dev/null 2>&1 || true
fi
if command -v ufw >/dev/null 2>&1; then
    ufw allow 22/tcp comment 'Reims Desktop SSH' >/dev/null 2>&1 || true
fi

exit 0
