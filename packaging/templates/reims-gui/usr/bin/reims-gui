#!/usr/bin/env bash
set -euo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${BIN_DIR}/reims-desktop" ]]; then
    exec "${BIN_DIR}/reims-desktop" "$@"
elif command -v reims-desktop &>/dev/null; then
    exec reims-desktop "$@"
else
    echo "ERRO: reims-desktop não encontrado!" >&2
    exit 1
fi
